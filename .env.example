# ---------------------------------------------------------------------------
# Football AI Predictor - environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# General
APP_ENV=development
LOG_LEVEL=INFO
# json (production) | console (human-readable)
LOG_FORMAT=console
# Local storage for raw JSON responses, cache and quota state
DATA_DIR=var
COMPETITIONS_FILE=configs/competitions.toml

# API-Football (https://www.api-football.com/documentation-v3)
# Get a free key at https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Free plan: 100 requests/day, 10 requests/minute. Adjust to your plan.
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_PER_MINUTE_LIMIT=10
# Requests kept in reserve that the collector will never consume automatically
API_FOOTBALL_QUOTA_RESERVE=5
API_FOOTBALL_TIMEOUT_SECONDS=20
API_FOOTBALL_MAX_RETRIES=4
API_FOOTBALL_BACKOFF_BASE_SECONDS=1.0
API_FOOTBALL_BACKOFF_MAX_SECONDS=60
# Timezone sent to the API for date-based queries (IANA name)
API_FOOTBALL_TIMEZONE=UTC
# Cache TTLs (seconds)
API_FOOTBALL_CACHE_TTL_LEAGUES=604800
API_FOOTBALL_CACHE_TTL_FIXTURES_PAST=604800
API_FOOTBALL_CACHE_TTL_FIXTURES_RECENT=900
